[Unit]
Description=calpi kiosk (cage + GTK app) on tty1
# Deliberately NOT waiting for network-online.target (US-01 D3): the calendar
# must appear immediately at boot, even offline.
After=systemd-user-sessions.service plymouth-quit-wait.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/tty1
# Never enter 'failed' because of restart limits (US-12); the crash guard handles crash loops
StartLimitIntervalSec=0

[Service]
Type=notify
# The notifier is python, a child of cage (the main PID)
NotifyAccess=all
User=kiosk
WorkingDirectory=/opt/calpi
# -d: no client-side decorations
ExecStart=/usr/bin/cage -d -- /usr/bin/python3 /opt/calpi/run.py
Environment=GSK_RENDERER=cairo
Environment=GTK_A11Y=none
Environment=PYTHONUNBUFFERED=1
# Persistent app state: /var/lib/calpi, owned by kiosk, exported as $STATE_DIRECTORY
StateDirectory=calpi
StateDirectoryMode=0700
# tmpfs scratch that survives service restarts but not reboots (US-12 crash counter)
RuntimeDirectory=calpi
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=5
# READY=1 is sent after the first painted frame; WATCHDOG=1 every 10 s from the GTK main loop
WatchdogSec=30
TimeoutStartSec=90
TimeoutStopSec=10
# systemd >= 254 only (Trixie); setup-pi.sh removes these two lines on older systemd
RestartSteps=5
RestartMaxDelaySec=60

# Real login session on tty1 so logind hands the seat (DRM/input) to cage
PAMName=calpi-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=graphical.target
